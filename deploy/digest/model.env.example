# Keep the real file outside the repository; for example /etc/ai-notes/digest.env.
# Compatible provider URL usually ends in /v1. No provider/model/price is assumed.
DIGEST_MODEL_BASE_URL=
DIGEST_MODEL_NAME=
DIGEST_MODEL_API_KEY=
# Optional: read the key from another variable in this same file, without copying it.
# DIGEST_MODEL_API_KEY_VAR=GLM_API_KEY
# GLM_API_KEY=
# Optional provider-supported effort; omit to preserve provider defaults.
# DIGEST_MODEL_REASONING_EFFORT=low
