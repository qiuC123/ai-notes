{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "impact-suite.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "frozen_at",
    "source_learning",
    "repositories",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "impact-suite.v2"
    },
    "suite_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,100}$"
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_learning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "relation_id",
        "external_repository",
        "external_commit_sha"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
        },
        "relation_id": {
          "type": "string",
          "pattern": "^rel-[0-9a-f]{12}$"
        },
        "external_repository": {
          "type": "string",
          "minLength": 1
        },
        "external_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "repository",
          "root",
          "git_head",
          "read_only"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "git_head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "read_only": {
            "const": true
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "title",
          "change_project",
          "change_description",
          "relationship",
          "affected_projects",
          "contract",
          "criticality",
          "required_tests",
          "evidence",
          "rationale"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^impact-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "change_project": {
            "type": "string",
            "minLength": 1
          },
          "change_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "relationship": {
            "enum": [
              "direct_dependency",
              "semantic_similarity"
            ],
            "description": "Existing project relationship; direct_dependency can have no affected_projects for a compatible change."
          },
          "affected_projects": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Only projects that must change to preserve correct behavior for this case."
          },
          "contract": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "criticality": {
            "enum": [
              "critical",
              "important",
              "routine"
            ]
          },
          "required_tests": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "project_id",
                "path",
                "selector"
              ],
              "properties": {
                "project_id": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "selector": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "path",
        "line_start",
        "line_end",
        "symbol",
        "claim"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    }
  }
}
