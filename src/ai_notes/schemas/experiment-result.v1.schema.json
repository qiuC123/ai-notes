{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "relation_id", "external_commit_sha", "approved_owned_project_state", "completed_at", "criterion_results", "retrospective"],
  "properties": {
    "schema_version": {"const": "experiment-result.v1"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
    "relation_id": {"type": "string", "pattern": "^rel-[0-9a-f]{12}$"},
    "external_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "approved_owned_project_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "git_head", "working_tree_fingerprint"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "git_head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "working_tree_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "completed_at": {"type": "string", "format": "date-time"},
    "criterion_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "inconclusive"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "retrospective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wrong_premise", "process_blind_spot", "next_step_candidate"],
      "properties": {
        "wrong_premise": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
        "process_blind_spot": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
        "next_step_candidate": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
