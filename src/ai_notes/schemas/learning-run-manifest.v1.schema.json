{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-run-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "started_at", "finished_at", "status", "healthy_no_connection", "policy_version", "queue_path", "decisions_path", "queue_sha256", "decisions_sha256", "missing_scopes", "validation_errors", "retained_until"],
  "properties": {
    "schema_version": {"const": "learning-run-manifest.v1"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["success", "partial", "review_failed", "failed"]},
    "healthy_no_connection": {"type": "boolean"},
    "policy_version": {"type": "string", "minLength": 1},
    "queue_path": {"type": "string", "minLength": 1},
    "decisions_path": {"type": ["string", "null"]},
    "queue_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "decisions_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "missing_scopes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "validation_errors": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "retained_until": {"type": "string", "format": "date-time"}
  }
}
