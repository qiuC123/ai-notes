{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-decisions.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "queue_sha256", "project_understanding", "risks", "connections", "no_connection_reason", "next_actions"],
  "properties": {
    "schema_version": {"const": "learning-decisions.v1"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
    "queue_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_understanding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "core_abstractions", "architecture", "non_applicable_conditions"],
      "properties": {
        "problem": {"type": "string", "minLength": 1},
        "core_abstractions": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/claim"}},
        "architecture": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/claim"}},
        "non_applicable_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 10}
      }
    },
    "risks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learning_only", "license_notes", "security_notes", "maintenance_notes"],
      "properties": {
        "learning_only": {"type": "boolean"},
        "license_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "security_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "maintenance_notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "connections": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/connection"}},
    "no_connection_reason": {"type": ["string", "null"]},
    "next_actions": {
      "type": "array",
      "items": {"enum": ["continue", "ignore", "watch", "experiment"]},
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "evidence_ids"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ext-[0-9a-f]{12}$"}, "uniqueItems": true}
      }
    },
    "owned_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "symbol", "start_line", "end_line", "file_sha256", "description"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "symbol": {"type": ["string", "null"]},
        "start_line": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1},
        "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "title", "hypothesis", "external_capability", "owned_project_problem", "expected_benefit", "costs", "risks", "experiment"],
      "properties": {
        "relation_id": {"type": "string", "pattern": "^rel-[0-9a-f]{12}$"},
        "title": {"type": "string", "minLength": 1},
        "hypothesis": {"type": "string", "minLength": 1},
        "external_capability": {"$ref": "#/$defs/claim"},
        "owned_project_problem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "claim", "evidence"],
          "properties": {
            "status": {"enum": ["confirmed", "inferred"]},
            "claim": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/owned_evidence"}}
          }
        },
        "expected_benefit": {"type": "string", "minLength": 1},
        "costs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "experiment": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["objective", "success_criteria"],
          "properties": {
            "objective": {"type": "string", "minLength": 1},
            "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  }
}
